// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DeploymentStatus {
  pending
  building
  success
  failed
  cancelled
}

model User {
  id          Int @id
  name        String?
  email       String @unique
  accessToken String
  login       String @unique
  avatarUrl   String
  createdAt   DateTime @default(now())
  projects    Project[]
  @@index([id])
}

model Project {
  id             Int @id @default(autoincrement())
  publicId       String @unique

  userId         Int
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  githubRepoId   Int
  name           String
  repoUrl        String

  createdAt      DateTime @default(now())
  updatedAt      DateTime            @updatedAt

  rootDir        String @default("/")
  installCmd     String @default("npm install")
  buildCmd       String @default("npm run build")
  framework      String?
  outputDir      String @default("dist")
  envVars        Json @default("{}")
  previewUrl     String?

  environments   ProjectEnvironment[]
  deployments    Deployment[]
  @@index([userId])
}

model Deployment {
  id        Int              @id @default(autoincrement())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  status    DeploymentStatus @default(pending)

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs      String?

  cdnUrl       String?
  artifactPath String?
  
  // TODO: change optional to required later
  commitHash            String
  commitMessage         String?
  commitAuthorName      String?
  commitAuthorEmail     String?
  commitAuthorUsername  String?

  @@index([projectId])
}

model ProjectEnvironment {
  id             Int      @id @default(autoincrement())
  projectId      Int
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name           String   // production, staging, preview, etc.
  branch         String   // main, develop, feature/payment, etc.

  isProduction   Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, name])
  @@unique([projectId, branch])
  @@index([projectId])
}