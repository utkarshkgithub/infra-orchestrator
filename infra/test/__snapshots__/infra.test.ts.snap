        "FunctionCode": "
function handler(event) {
    var request = event.request;
    var deployment = request.headers.host.value.split(".")[0];

    if (request.uri === "/") {
        request.uri = "/" + deployment + "/index.html";
        return request;
    }

    // Static asset
    if (request.uri.includes(".")) {
        request.uri = "/" + deployment + request.uri;
        return request;
    }

    // SPA route
    request.uri = "/" + deployment + "/index.html";
    return request;
}
